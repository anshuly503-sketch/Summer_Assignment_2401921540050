class Solution {
public:
    int maxProfit(vector<int>& arr) {
        int mini = arr[0];
        int profit = -1;
        int n = arr.size();
        for(int i =0;i<n;i++)
        {
            if(arr[i]>mini)
            {
                profit = max(profit, arr[i]-mini);
            }
            mini = min(mini,arr[i]);
        }
        if(profit<0)
        {
            return 0;
        }
        return profit;
    }
};
